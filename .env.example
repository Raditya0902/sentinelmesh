# LLM backend (Lobster Trap proxies all agent calls to this)
# For Railway/cloud: use Groq (https://console.groq.com/keys)
# For local: use Ollama (http://localhost:11434)
LLM_BACKEND_URL=https://api.groq.com/openai
LLM_MODEL=openai/gpt-oss-120b

# API key forwarded through Lobster Trap to the LLM backend
# Set GROQ_API_KEY for Groq, OPENAI_API_KEY for OpenAI
GROQ_API_KEY=

# Lobster Trap proxy (all agents point here instead of the LLM directly)
LOBSTER_TRAP_URL=http://localhost:8080
LOBSTER_TRAP_POLICY=proxy/policy.yaml
LOBSTER_TRAP_AUDIT_LOG=logs/audit.jsonl

# FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chromadb

# Streamlit dashboard
DASHBOARD_PORT=8501

# Audit log path (also written by Lobster Trap)
AUDIT_LOG_PATH=logs/audit.jsonl

# ── Caller authentication ─────────────────────────────────────────────────────
# The API refuses to start without at least one key (fail closed).
# Each key is bound to one RBAC role on the server; callers cannot pick their role.
# Generate a full set with:  make keys
SENTINEL_CALLER_KEYS=
# Optional single admin key (used by the dashboard). Treated as role "admin".
SENTINEL_API_KEY=
# Set to 1 ONLY for a local throwaway demo: allows startup with no keys, serves
# anonymous /run calls as "readonly", and leaves governance endpoints open.
SENTINEL_DEMO_MODE=
# ── Agent identity (Lobster Trap) ────────────────────────────────────────────
# JSON map agent_id → secret. Agents send their key as X-Agent-Key; the proxy denies
# any call whose agent_id/key disagree or whose declared_intent is not registered for
# that agent in proxy/policy.yaml (agents: section). The proxy refuses to start if a
# registered agent has no key. Generate with:  make keys
LT_AGENT_KEYS=
# Audit writes fail closed (request errors if the audit entry can't be written).
# Defaults to 1 unless SENTINEL_DEMO_MODE=1.
AUDIT_STRICT=
